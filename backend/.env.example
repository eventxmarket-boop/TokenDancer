# ====== 应用基础 ======
APP_NAME=Demo Platform Backend
APP_ENV=dev        # dev | prod
DEBUG=true

# ====== 数据库 ======
# 开发（SQLite）：
DATABASE_URL=sqlite:///./demo_platform.db
# 生产（PostgreSQL，docker-compose 使用此格式）：
# DATABASE_URL=postgresql+psycopg://demoplat:change-me@localhost:5432/demoplat

# ====== 安全（必须修改！） ======
# 生成强随机密钥:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7天

# ⚠️ 生产环境 (APP_ENV=prod) 必须使用强密钥，否则服务无法启动！
# - 长度必须 >= 32
# - 不能是占位符（change_this / secret / password / test 等）

# ====== CORS（生产环境） ======
EXTRA_CORS_ORIGINS=

# ====== 支付配置 ======
PAYMENT_PROVIDER=mock   # 'stripe' | 'mock' | 'alipay_qr'
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# 通用 webhook 校验密钥（Stripe 以外的场景使用）
PAYMENT_WEBHOOK_SECRET=

# ====== 邮件配置 ======
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# ====== 限流配置 ======
# 设为 true 开启限流保护
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN=10           # 次/分钟（每个 email）
RATE_LIMIT_REGISTER=5         # 次/分钟（每个 email）
RATE_LIMIT_REDEEM=20          # 次/分钟（每个 user）
RATE_LIMIT_WEBHOOK=60        # 次/分钟（每个 IP）
RATE_LIMIT_PASSWORD=5          # 次/分钟（每个 user）

# ====== 登录失败冷却 ======
LOGIN_COOLDOWN_ENABLED=true   # 登录冷却总开关
LOGIN_MAX_FAILURES=5          # 连续失败次数上限
LOGIN_COOLDOWN_SECONDS=300    # 冷却时间（秒），约 5 分钟

# ====== 代理 & Admin 限流 ======
RATE_LIMIT_PROXY=60           # proxy 入口每分钟限流（per user）
RATE_LIMIT_ADMIN_MUTATION=30  # admin 高风险操作每分钟限流

# ====== 代理模式 ======
PROXY_MODE=open               # open | strict

# ====== Docker 部署 ======
# 在 docker-compose.yml 所在目录运行：
#   docker-compose up --build -d
#   docker-compose exec backend alembic upgrade head
#
# 必需的环境变量（在 .env 中设置或通过环境传入）：
#   POSTGRES_PASSWORD=change-me        # PostgreSQL 密码
#   SECRET_KEY=<64位随机字符串>         # JWT 签名密钥
#   PAYMENT_WEBHOOK_SECRET=<你的密钥>   # Webhook 验签密钥
