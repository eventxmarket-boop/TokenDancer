[Unit]
Description=TokenDancer Persona Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/xuedingtoken_latest/backend
ExecStart=/opt/xuedingtoken_latest/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
