{
  "name": "mescladis-appointment-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node monitor.js",
    "monitor": "node monitor.js",
    "plus:bridge": "node plus_bridge.js",
    "plus:bridge:cdp": "node plus_bridge.js --transport cdp --cdp-launch",
    "qclaw:image-bridge:status": "python3 backend/scripts/qclaw_image_bridge_status_probe.py",
    "health:daemon": "node monitor_health_daemon.js",
    "agendapro:monitor": "AGENDAPRO_ALERT_FILE_PATH=/Users/chanzi/.qclaw/workspace-agent-be2ecf0c/agendapro_alert.txt node agendapro_monitor.js",
    "montjuic:monitor": "MONTJUIC_ALERT_FILE_PATH=/Users/chanzi/.qclaw/workspace-agent-be2ecf0c/montjuic_alert.txt node montjuic_monitor.js",
    "publicpage:monitor": "PUBLIC_PAGE_ALERT_FILE_PATH=/Users/chanzi/.qclaw/workspace-agent-be2ecf0c/public_page_alert.txt node public_page_monitor.js",
    "publicpage:daemon": "ALERT_FILE_PATH=/Users/chanzi/.qclaw/workspace-agent-be2ecf0c/public_page_alert.txt FORWARD_ALL_STATUSES=true node calendar_alert_daemon.js",
    "alert:daemon": "node calendar_alert_daemon.js",
    "install:chromium": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  }
}
